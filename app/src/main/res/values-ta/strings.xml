    <!-- தொடக்க வழிகாட்டல் (Onboarding) -->
    <string name="onboarding_welcome_title">Exam Rescue இற்கு நல்வரவு</string>
    <string name="onboarding_welcome_subtitle">இலங்கை க.பொ.த சாதாரண தர (GCE O/L) மாணவர்கள் தெளிவுடனும் தன்னம்பிக்கையுடனும் பரீட்சைக்குத் தயாராக உதவும் செயலி.</string>
    <string name="onboarding_offline_notice">முழுமையாக இணையமின்றி இயங்கக்கூடியது. உங்கள் பாடத்திட்டம், குறிப்புகள், அட்டவணைகள் உங்கள் கைப்பேசியிலேயே பாதுகாப்பாக இருக்கும். கணக்கு பதிவு அல்லது சேவையகத் தேவையில்லை.</string>
    <string name="onboarding_lang_title">செயலி மொழியைத் தேர்வுசெய்க</string>
    <string name="onboarding_medium_title">கற்கும் மொழி மூலத்தைத் தேர்வுசெய்க</string>
    <string name="onboarding_medium_desc">உங்கள் க.பொ.த சாதாரண தரப் பரீட்சை மொழி மூலத்தைத் தேர்ந்தெடுக்கவும். செயலி மொழியிலிருந்து சுயாதீனமாக தமிழ் அல்லது ஆங்கில மொழி மூலத்தைத் தேர்வுசெய்யலாம்.</string>
    <string name="lang_english">English (ஆங்கிலம்)</string>
    <string name="lang_tamil">தமிழ் (Tamil)</string>
    <string name="medium_english">ஆங்கில மொழி மூலம் (English Medium)</string>
    <string name="medium_tamil">தமிழ் மொழி மூலம் (Tamil Medium)</string>
    <string name="onboarding_target_exam_title">க.பொ.த சா/த பரீட்சைத் திகதி</string>
    <string name="onboarding_target_exam_subtitle">உங்கள் உத்தேச பரீட்சைத் திகதியை உள்ளிடவும் அல்லது \'தெரியாது\' என்பதைத் தேர்வுசெய்க.</string>
    <string name="onboarding_not_sure">இன்னும் உறுதியாகத் தெரியாது</string>
    <string name="onboarding_subjects_title">உங்கள் பாடங்களைத் தேர்வுசெய்க</string>
    <string name="onboarding_subjects_subtitle">உங்கள் 6 பிரதான பாடங்கள் மற்றும் தொகுதிப் பாடங்களைத் தெரிவுசெய்யவும். இதனை எப்போது வேண்டுமானாலும் மாற்றலாம்.</string>
    <string name="onboarding_availability_title">தினசரி படிப்பு நேரம்</string>
    <string name="onboarding_availability_subtitle">ஒரு சாதாரண நாளில் எத்தனை நிமிடங்கள் படிக்க முடியும்?</string>
    <string name="onboarding_session_length_title">விருப்பமான அமர்வு நேரம்</string>
    <string name="onboarding_ai_disclosure_title">விருப்பத் தெரிவான செயற்கை நுண்ணறிவு (AI)</string>
    <string name="onboarding_ai_disclosure_body">அனைத்து பிரதான அம்சங்களும் எந்தவொரு API சாவியும் இன்றி இணையமில்லாமலேயே செயல்படும். AI வழிகாட்டியைப் பயன்படுத்த விரும்பினால், நீங்கள் விரும்பும் நேரத்தில் உங்கள் சொந்த API சாவியை இணைக்கலாம்.</string>

